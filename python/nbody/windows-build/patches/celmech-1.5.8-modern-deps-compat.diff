--- a/celmech/disturbing_function.py
+++ b/celmech/disturbing_function.py
@@ -606,7 +606,7 @@ def calX_term(a,b,c,d):
     float
     """
     tot = 0
-    for n in xrange(d+1):
+    for n in range(d+1):
         tot += binom(-0.5,n) * (-1)**n * HansenCoefficient_term(a,b,c,d - n)
     return tot
 
