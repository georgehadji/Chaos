+    def get_export_symbols(self, ext):
+        # libreboundx is loaded with ctypes and has no PyInit_libreboundx. setuptools would otherwise
+        # pass /EXPORT:PyInit_libreboundx to the MSVC linker, which fails.
+        return []
+
+    def build_extension(self, ext):
+        if sys.platform != 'win32':
+            return _build_ext.build_extension(self, ext)
+        import rebound
+        rebdir = os.path.dirname(inspect.getfile(rebound))
+        rebound_dll = os.path.join(os.path.dirname(rebdir), 'librebound'+suffix)
+        cc = self.compiler
+        cc.initialize()
+        os.makedirs(self.build_temp, exist_ok=True)
+        # 1. import library for librebound, made from the DLL's export table
+        implib = os.path.join(self.build_temp, 'librebound'+suffix[:suffix.rfind('.')]+'.lib')
+        deffile = os.path.splitext(implib)[0] + '.def'
+        with open(deffile, 'w') as f:
+            f.write('LIBRARY '+os.path.basename(rebound_dll)+'\nEXPORTS\n')
+            f.write(''.join('    '+n+'\n' for n in _pe_export_names(rebound_dll)))
+        subprocess.check_call([cc.lib, '/nologo', '/MACHINE:X64', '/DEF:'+deffile, '/OUT:'+implib])
+        # 2. compile (without /GL so the objects keep a readable COFF symbol table)
+        objects = cc.compile(ext.sources, output_dir=self.build_temp, macros=ext.define_macros,
+                             include_dirs=ext.include_dirs, debug=self.debug,
+                             extra_postargs=list(ext.extra_compile_args) + ['/GL-'])
+        # 3. export every external symbol we define, then link
+        names = sorted({n for o in objects for n in _coff_defined_externals(o)
+                        if not n.startswith('_') and not n.startswith('PyInit_')})
+        extdef = os.path.join(self.build_temp, ext.name+'.def')
+        with open(extdef, 'w') as f:
+            f.write('EXPORTS\n'+''.join('    '+n+'\n' for n in names))
+        cc.link_shared_object(objects + [implib], self.get_ext_fullpath(ext.name),
+                              library_dirs=ext.library_dirs, build_temp=self.build_temp,
+                              extra_postargs=['/DEF:'+extdef] + list(ext.extra_link_args),
+                              target_lang='c')
 
 
