+#ifdef _WIN32
+// REBOUND declares `extern const struct reb_integrator reb_integrator_ias15` (and _whfast) without REB_API, so
+// they are not exported from REBOUND's Windows DLL and cannot be linked against. Obtain the same callbacks at
+// run time from a scratch simulation instead; behaviour is identical to using the exported structs elsewhere.
+static const struct reb_integrator* rebx_win_integrator(const char* name, struct reb_integrator* cache, int* have){
+    if (!*have){
+        struct reb_simulation* scratch = reb_simulation_create();
+        reb_simulation_set_integrator(scratch, name);
+        *cache = scratch->integrator.callbacks;
+        reb_simulation_free(scratch);
+        *have = 1;
+    }
+    return cache;
+}
+static const struct reb_integrator* rebx_win_ias15(void){
+    static struct reb_integrator cache; static int have = 0;
+    return rebx_win_integrator("ias15", &cache, &have);
+}
+static const struct reb_integrator* rebx_win_whfast(void){
+    static struct reb_integrator cache; static int have = 0;
+    return rebx_win_integrator("whfast", &cache, &have);
+}
+#define reb_integrator_ias15 (*rebx_win_ias15())
+#define reb_integrator_whfast (*rebx_win_whfast())
+#endif
