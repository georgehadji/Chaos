+# ---- Windows (MSVC) support -------------------------------------------------------------------
+# REBOUND's Windows wheel ships librebound<suffix> (a DLL with a .pyd extension) but no import
+# library, and MSVC does not export symbols from a DLL unless told to. libreboundx is loaded
+# through ctypes (not imported as a Python module), so we (1) generate an import library for
+# librebound from its export table and (2) export every external symbol defined in our own
+# object files through a generated .def file. Both are done in pure Python (no dumpbin needed).
+import struct, subprocess
+
+def _pe_export_names(path):
+    """Names in the export table of a PE file."""
+    d = open(path, 'rb').read()
+    pe = struct.unpack_from('<I', d, 0x3c)[0]
+    nsec, opt = struct.unpack_from('<H', d, pe + 6)[0], struct.unpack_from('<H', d, pe + 20)[0]
+    opt_off = pe + 24
+    magic = struct.unpack_from('<H', d, opt_off)[0]
+    dd_off = opt_off + (112 if magic == 0x20b else 96)  # data directories (PE32+ / PE32)
+    exp_rva = struct.unpack_from('<I', d, dd_off)[0]
+    secs = [struct.unpack_from('<8sIIII', d, opt_off + opt + 40 * i)[1:] for i in range(nsec)]
+    def off(rva):
+        for vsize, va, rsize, rptr in secs:
+            if va <= rva < va + max(vsize, rsize):
+                return rva - va + rptr
+        raise ValueError("bad RVA")
+    e = off(exp_rva)
+    nnames, names_rva = struct.unpack_from('<I', d, e + 24)[0], struct.unpack_from('<I', d, e + 32)[0]
+    out = []
+    for i in range(nnames):
+        s = off(struct.unpack_from('<I', d, off(names_rva) + 4 * i)[0])
+        out.append(d[s:d.index(b'\0', s)].decode('ascii'))
+    return out
+
+def _coff_defined_externals(path):
+    """Names of external symbols defined (not merely referenced) in a COFF object file."""
+    d = open(path, 'rb').read()
+    symptr, nsyms = struct.unpack_from('<II', d, 8)
+    strtab = symptr + 18 * nsyms
+    out, i = [], 0
+    while i < nsyms:
+        o = symptr + 18 * i
+        raw, _value, section, _type, storage, naux = struct.unpack_from('<8sIhHBB', d, o)
+        if raw[:4] == b'\0\0\0\0':
+            s = strtab + struct.unpack_from('<I', raw, 4)[0]
+            name = d[s:d.index(b'\0', s)].decode('ascii', 'replace')
+        else:
+            name = raw.rstrip(b'\0').decode('ascii', 'replace')
+        if storage == 2 and section > 0:  # IMAGE_SYM_CLASS_EXTERNAL, defined in a section
+            out.append(name)
+        i += 1 + naux
+    return out
+
